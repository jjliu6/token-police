{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "1.3.17",
  "description": "__MSG_extDesc__",
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/mark-16.png",
      "32": "icons/mark-32.png",
      "48": "icons/mark-48.png",
      "128": "icons/mark-128.png"
    }
  },
  "icons": {
    "16": "icons/mark-16.png",
    "32": "icons/mark-32.png",
    "48": "icons/mark-48.png",
    "128": "icons/mark-128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel", "alarms", "notifications"],
  "side_panel": { "default_path": "popup.html" },
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://grok.com/*",
    "https://cursor.com/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://grok.com/*",
        "https://cursor.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
